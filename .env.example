# Copy this file to .env.local for local dev (gitignored).
# Set the same two values in Vercel → Project Settings → Environment Variables for production.
# Both come from Supabase Dashboard → Project Settings → API.
# Neither of these is the database password — never put that anywhere in this project.

VITE_SUPABASE_URL=https://byygfvgqjtcajvlrhmcc.supabase.co
VITE_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# Server-side only — deliberately has NO VITE_ prefix, so Vite never bundles
# it into client-side JS. Only the /api/send-notification.js serverless
# function reads this. Get it from resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxx
